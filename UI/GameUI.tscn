[gd_scene load_steps=2 format=3 uid="uid://gameuiscene"]

[ext_resource type="Script" path="res://UI/game_ui.gd" id="1_script"]

[node name="GameUI" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_script")

[node name="PausePanel" type="ColorRect" parent="."]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 1)

[node name="CenterContainer" type="CenterContainer" parent="PausePanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="PausePanel/CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Label" type="Label" parent="PausePanel/CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "PAUSED"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="PausePanel/CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Resume"

[node name="QuitButton" type="Button" parent="PausePanel/CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Quit"

[node name="WinPanel" type="VBoxContainer" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -100.0
offset_top = -100.0
offset_right = 100.0
offset_bottom = 100.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="Label" type="Label" parent="WinPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Level Complete!"
horizontal_alignment = 1

[node name="ContinueButton" type="Button" parent="WinPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Continue"

[node name="RetryButton" type="Button" parent="WinPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Retry"

[node name="QuitButton" type="Button" parent="WinPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Quit"

[node name="LosePanel" type="VBoxContainer" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -100.0
offset_top = -100.0
offset_right = 100.0
offset_bottom = 100.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="Label" type="Label" parent="LosePanel"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.2, 0.2, 1)
theme_override_font_sizes/font_size = 32
text = "Game Over"
horizontal_alignment = 1

[node name="RetryButton" type="Button" parent="LosePanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Retry"

[node name="QuitButton" type="Button" parent="LosePanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Quit"

[connection signal="pressed" from="WinPanel/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="WinPanel/RetryButton" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="WinPanel/QuitButton" to="." method="_on_quit_pressed"]
[connection signal="pressed" from="LosePanel/RetryButton" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="LosePanel/QuitButton" to="." method="_on_quit_pressed"]
